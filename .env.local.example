# ===== Supabase =====
# project_ref: zwgqzutknvbmronqkkzw
# MCP 툴 `get_project_url`, `get_publishable_keys` 로 값 조회 가능
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Legacy JWT anon key — 과거 호환용. 신규 서버/배치 접근에는 사용하지 않음.
SUPABASE_LEGACY_ANON_KEY=

# 서버/배치 전용 필수 키 (service_role — 절대 클라이언트 노출 금지)
# Supabase 대시보드 → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ===== AI 백엔드 =====
# 옵션 1) Vercel AI Gateway 사용 (기본)
#   https://vercel.com/docs/ai-gateway
#   - AI_GATEWAY_API_KEY 만 채우면 됨
#   - 모델은 provider/model 포맷 (예: anthropic/claude-opus-4-6, openai/text-embedding-3-small)
AI_GATEWAY_API_KEY=
DEFAULT_AI_MODEL=anthropic/claude-opus-4-6
DEFAULT_EMBED_MODEL=openai/text-embedding-3-small

# 옵션 2) OpenAI 직접 호출 (AI Gateway 없이)
#   아래 4줄 주석 해제 + 실제 키 넣고, 위쪽 옵션 1 라인은 삭제하거나 비워둘 것.
# AI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# DEFAULT_AI_MODEL=gpt-4o-mini
# DEFAULT_EMBED_MODEL=text-embedding-3-small
