SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ranking → cluster → gap 체이닝 (매시 7분 UTC) — 수집 직후 즉시 클러스터링·미보도탐지 (실시간 이슈 대응 복원)
# NCP crontab 은 고정 시각만 지원 → ranking 성공 직후 &&로 cluster·gap 연쇄 (GitHub Actions workflow_run 연쇄 대체)
# cluster --hours 4: 매시간 주기에 맞춰 직전 4시간 미할당 기사 재평가 (늦게 합류한 매체 커버). threshold 0.85 유지(47차→48차 모니터링)
7 * * * * root cd /app && python -m scripts.collect_ranking >> /var/log/cron.log 2>&1 && python -m scripts.cluster_articles --hours 4 --threshold 0.85 --min-size 2 >> /var/log/cron.log 2>&1 && python -m scripts.detect_gap --days 1 --min-competitors 2 >> /var/log/cron.log 2>&1

# publications — 10분마다
2,12,22,32,42,52 * * * * root cd /app && python -m scripts.collect_publications >> /var/log/cron.log 2>&1

# trends — 3분마다 (DOM 파싱 v2, hours=4&status=active)
*/3 * * * * root cd /app && python -m scripts.collect_trends >> /var/log/cron.log 2>&1

# comments — 매시 15분 UTC
15 * * * * root cd /app && python -m scripts.collect_comments >> /var/log/cron.log 2>&1

# cluster / gap 은 위 ranking 라인에 체이닝됨 (매시간) — 기존 6시간 주기 독립 라인 제거 (48차)

# section-ranking — 매시 7분 UTC (네이버 섹션 랭킹 매시간 업데이트에 맞춤, 인기랭킹과 동일 시각)
7 * * * * root cd /app && python -m scripts.collect_section_ranking >> /var/log/cron.log 2>&1

# editorials — KST 06:00/14:00/22:00 = UTC 21:00/05:00/13:00
# 수집 직후 merge_editorial_issues 체이닝: 그날 전체 사설을 사건 단위 canonical issue 로 재배정 (오늘의 사설 그룹 파편화 해소)
0 21 * * * root cd /app && python -m scripts.collect_editorials >> /var/log/cron.log 2>&1 && python -m scripts.merge_editorial_issues >> /var/log/cron.log 2>&1
0 5 * * * root cd /app && python -m scripts.collect_editorials >> /var/log/cron.log 2>&1 && python -m scripts.merge_editorial_issues >> /var/log/cron.log 2>&1
0 13 * * * root cd /app && python -m scripts.collect_editorials >> /var/log/cron.log 2>&1 && python -m scripts.merge_editorial_issues >> /var/log/cron.log 2>&1

# daily-briefing — UTC 15:00 (KST 00:00)
0 15 * * * root cd /app && python -m scripts.generate_daily_briefing >> /var/log/cron.log 2>&1

# cleanup — UTC 15:05
5 15 * * * root cd /app && python -m scripts.cleanup_old_data >> /var/log/cron.log 2>&1

# naver-pv — UTC 20:00 (KST 05:00) 1차 수집, UTC 22:00 (KST 07:00) fallback (pv=0이면 재수집)
0 20 * * * root cd /app && python -m scripts.collect_naver_pv >> /var/log/cron.log 2>&1
0 22 * * * root cd /app && python -m scripts.collect_naver_pv --skip-if-collected >> /var/log/cron.log 2>&1

# naver-pv 실시간(오늘 지표) — 10분마다. /api/today 로 오늘 총조회수·기사순위·유입경로 + 누적 tick 수집
*/10 * * * * root cd /app && python -m scripts.collect_naver_pv --realtime >> /var/log/cron.log 2>&1

# subscribers — UTC 23:00 (KST 08:00)
0 23 * * * root cd /app && python -m scripts.collect_subscribers >> /var/log/cron.log 2>&1

# foreign-editorials — KST 06:00/14:00/22:00 = UTC 21:00/05:00/13:00 (한국 사설과 동일)
# 하루 3회 수집(시차로 늦게 올라오는 매체 누락 방지). 기존 URL은 재번역 안 함 → 비용 영향 미미
0 21 * * * root cd /app && python -m scripts.collect_foreign_editorials --all >> /var/log/cron.log 2>&1
0 5 * * * root cd /app && python -m scripts.collect_foreign_editorials --all >> /var/log/cron.log 2>&1
0 13 * * * root cd /app && python -m scripts.collect_foreign_editorials --all >> /var/log/cron.log 2>&1
